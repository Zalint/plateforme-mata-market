// Schéma Prisma · Lot 1 + Lot 2 + Lot 3 + Lot 4 + Lot 5
//
// Lot 1 — identité & audit :
//  - users                       identité MATA + mapping Keycloak
//  - audit_log                   toutes actions sensibles
//  - notification_preferences    réservé Lot 7 push
//
// Lot 2 — producteurs, sites, offres :
//  - zones                       référentiel géographique (FK pour producer / site)
//  - producer_profiles           profil producteur 1:1 avec users (role=producer)
//  - production_sites            sites de production / retrait (ferme, poulailler, dépôt, mareyage)
//  - offers                      offres produit + workflow validation
//  - offer_photos                photos d'offre via Cloudinary public_id
//
// Lot 3 — pricing 7 composantes :
//  - pricing_rules               règles configurables (par catégorie OU override par offre)
//                                4 modèles économiques × 3 bases pct (producer / final / subtotal)
//  - pricing_snapshots           fige les 7 composantes par order_item au moment de la commande
//                                IMMUABLE après création (invariant comptable, cf. CLAUDE.md §G4)
//                                Lot 4 : FK order_items.pricing_snapshot_id ajoutée (1:1 inverse).
//
// Lot 4 — commandes + cycle 8 étapes :
//  - orders                      en-tête commande (CMD-2026-NNNN), 8 statuts cycle nominal +
//                                cancelled, livraison zone+slot, total_fcfa figé à la création.
//  - order_items                 lignes de commande, 1:1 vers pricing_snapshots, dénormalisation
//                                producer_user_id pour requêtes producteur fréquentes (cf. §6).
//  - idempotency_records         (key, scope) → response cache 24h pour POST /v1/orders.
//  - OfferStatus.reserved/sold   ajout des valeurs prévues Lot 2 (résolution backlog L2→L4).
//  - SEQUENCE order_number_seq   numéro CMD-{YYYY}-{NNNN} atomique sans collision.
//
// Lot 5 — paiements Bictorys + reversements :
//  - PaymentStatus enum          remplace orders.payment_status (TEXT stub Lot 4).
//                                Migration EN DEUX TEMPS (part1 ajout+backfill, part2 drop+rename)
//                                pour valider la procédure prod (cf. CLAUDE.md §G4, BACKLOG [lot-2→lot-9]).
//  - PayoutStatus enum           états d'un reversement Bictorys disbursement.
//  - payments                    1:1 inverse vers orders (provider_intent_id unique, raw_webhook_payload
//                                jsonb pour audit post-mortem, idempotence par provider_intent_id).
//  - payouts                     reversement producteur (montant agrégé, status sent/failed/blocked,
//                                provider_disbursement_id côté Bictorys).
//  - payout_items                table de liaison payout ↔ order_item, UNIQUE sur order_item_id
//                                pour empêcher tout double-versement (idempotence cron payouts).
//  - outbox_events               Pattern Outbox (CLAUDE.md §G3, ARCHITECTURE.md §7) : émission
//                                d'events 'order.confirmed' au webhook payment.paid. Le cron
//                                retry-outbox (Lot 7) les dispatchera vers n8n.
//
// Conventions :
//  - Tables Postgres en snake_case via @map, code TS en camelCase
//  - Pas de soft-delete générique, statuts métier explicites
//  - 6 rôles miroir du realm Keycloak (cf. infra/keycloak/realm-export.json)
//  - bank_details (jsonb) chiffré applicatif AES-256-GCM côté service avant insertion
//  - FCFA en entiers, pourcentages en entiers (0-100), jamais Decimal/Float
//
// Référence : ARCHITECTURE.md §6 « Modèle de données ».

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

// Prisma 7 : la connection string passe désormais par `prisma.config.ts`
// (pour Migrate) et par le `driverAdapter` côté client (cf. lib/prisma.ts).
// Le bloc `datasource` ne déclare plus que le provider.
datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────
// Enums · Lot 1
// ─────────────────────────────────────────────────────────────────

enum UserRole {
  producer
  client_pro
  client_particulier
  admin
  teleconsultant
  super_admin

  @@map("user_role")
}

enum UserStatus {
  active
  suspended
  blacklisted

  @@map("user_status")
}

enum PreferredLocale {
  fr
  wo // wolof
  ff // pulaar

  @@map("preferred_locale")
}

// ─────────────────────────────────────────────────────────────────
// Enums · Lot 2
// ─────────────────────────────────────────────────────────────────

enum ProducerType {
  poultry // aviculteur (poulets et/ou œufs)
  cattle // éleveur bovin
  sheep // éleveur ovin (mouton)
  vegetables // maraîcher
  fish // mareyeur / pêche
  mixed // multi-élevages / mixte

  @@map("producer_type")
}

enum ProducerStatus {
  pending // créé, en attente de validation MATA
  validated // validé, peut publier des offres
  suspended // suspendu temporairement par MATA
  blacklisted // banni définitivement

  @@map("producer_status")
}

enum SiteType {
  poulailler // élevage volaille
  ferme // ferme générique (bovin, ovin, mixte)
  depot // dépôt / point de retrait sans production
  mareyage // site mareyeur (port, débarcadère)

  @@map("site_type")
}

enum SiteStatus {
  active
  archived // masqué sans destruction, préserve les FK offers existantes

  @@map("site_status")
}

// DEPRECATED (lot catégories dynamiques) : l'enum est conservé en Release 1 le
// temps de la bascule vers la table `product_categories` (FK categorySlug). Il
// sera supprimé en Release 2 (cf. docs/BACKLOG.md). Ne plus l'utiliser dans le
// nouveau code — la source de vérité des catégories est désormais le modèle
// `Category` ci-dessous.
enum ProductCategory {
  poultry
  eggs
  cattle
  sheep
  vegetables
  fish

  @@map("product_category")
}

// ─────────────────────────────────────────────────────────────────
// product_categories · taxonomie produit DATA-DRIVEN (gérable par l'admin)
//
// Remplace l'enum ProductCategory (figé, migration par valeur) par une table :
// l'admin crée/renomme/désactive une catégorie depuis l'UI, sans migration ni
// déploiement. `slug` est la clé stable (= anciennes valeurs de l'enum) servant
// de FK sur offers.category_slug et pricing_rules.category_slug.
//
// `isActive` = statut métier (PAS un soft-delete générique, §G4) : on désactive
// au lieu de supprimer pour ne jamais casser une offre/commande qui pointe dessus.
// Dérogation §E2/§G4 actée dans ARCHITECTURE.md (taxonomie dynamique assumée).
// ─────────────────────────────────────────────────────────────────
model Category {
  slug      String   @id // ex. "poultry", "caprin" — stable, référencé en FK
  labelFr   String   @map("label_fr")
  emoji     String
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  offers       Offer[]
  pricingRules PricingRule[]

  @@index([isActive, sortOrder])
  @@map("product_categories")
}

enum OfferStatus {
  draft // brouillon producteur, modifiable
  pending // soumise à MATA pour validation
  changes_requested // renvoyée au producteur pour correction (rejection_reason = feedback, réversible + éditable)
  validated // visible au catalogue, stock dispo
  rejected // refusée par MATA (rejection_reason rempli, définitif)
  expired // date limite availableUntil dépassée (cron), relançable en draft
  archived // rangée par le producteur (depuis draft/rejected), restaurable en draft
  suspended // masquée par admin ou producteur après validation

  // Ajoutés Lot 4 (résolution backlog L2→L4).
  reserved // stock épuisé temporairement (quantityReserved === quantity) — un cancel peut revenir validated
  sold // épuisé définitivement (tout livré, retiré du catalogue) — pas de retour validated

  @@map("offer_status")
}

enum OfferUnit {
  unit // unité (poulet entier, mouton sur pied)
  kg // kilogramme (viande, poisson)
  tray // plateau (œufs, généralement 30)
  crate // caisse (poisson, légumes en gros)
  head // tête (bovin/ovin sur pied)

  @@map("offer_unit")
}

// ─────────────────────────────────────────────────────────────────
// Enums · Lot 3 (pricing)
// ─────────────────────────────────────────────────────────────────

enum PricingModel {
  commission_pct // commission = pct × base, marge fixe ignorée
  fixed_margin // commission = montant FCFA fixe par unité, pct ignoré
  mixed // commission = pct × base + montant fixe
  negotiated // équivalent à fixed_margin côté math, étiquette métier "gros volume négocié"

  @@map("pricing_model")
}

enum PricingScope {
  category // règle par défaut pour une product_category
  offer // override pour une offre précise (priorité sur category)

  @@map("pricing_scope")
}

// Sur quelle base les pourcentages (commission %, marge sécurité %) s'appliquent.
// Choix par champ (commission_base, safety_margin_base) → 9 combinaisons possibles.
enum PricingBase {
  producer_price // base = prix producteur (simple, recommandé MVP)
  final_price // base = prix final client (formule circulaire, résolue algébriquement)
  subtotal_pre_pct // base = producer + collecte + livraison + storage (compromis)

  @@map("pricing_base")
}

// ─────────────────────────────────────────────────────────────────
// Enums · Lot 4 (orders)
// ─────────────────────────────────────────────────────────────────

// Cycle nominal 7 étapes + cancelled (cf. mockup §sec-status-orders + ARCHITECTURE.md §13).
// Statuts "lateral" payment_pending et disputed réservés Lot 5 (paiements Bictorys).
enum OrderStatus {
  created // panier validé, en attente confirmation MATA
  confirmed // MATA accepte, producteurs notifiés, stock réservé
  collecting // MLC en tournée chez les producteurs
  collected // tous les items récupérés, en route vers dépôt
  stored // entrée chambre froide, en attente tournée livraison
  delivering // livreur en route vers client
  delivered // client a confirmé la réception, déclenche reversement
  cancelled // annulée client (avant collecte) OU MATA (rupture, problème)

  @@map("order_status")
}

// Créneau de livraison (date + période morning/afternoon — cf. §I glossaire).
enum DeliveryPeriod {
  morning // 6h–12h
  afternoon // 14h–18h

  @@map("delivery_period")
}

// ─────────────────────────────────────────────────────────────────
// Enums · Lot 5 (paiements + reversements Bictorys)
// ─────────────────────────────────────────────────────────────────

// PaymentStatus — état d'un payment intent Bictorys côté MATA.
// Mapping vs statuts Bictorys :
//   opened/pending → pending     (lien généré, en attente client)
//   paid/succeeded → paid        (webhook reçu, order passe en `confirmed`)
//   refunded       → refunded    (rare ; aussi mis si webhook 'paid' arrive APRÈS cancel order)
//   disputed       → disputed    (chargeback ; payouts liés bloqués)
enum PaymentStatus {
  pending
  paid
  refunded
  disputed

  @@map("payment_status")
}

// PayoutStatus — état d'un disbursement Bictorys côté MATA.
//   pending  → row créée côté MATA, en attente confirmation Bictorys
//   sent     → Bictorys a confirmé le virement
//   failed   → erreur (coordonnées invalides, plafond, réseau) — failure_reason rempli
//   blocked  → bloqué manuellement par admin (dispute, KYC)
enum PayoutStatus {
  pending
  sent
  failed
  blocked

  @@map("payout_status")
}

// ─────────────────────────────────────────────────────────────────
// Enums · Lot 7 (tournées de collecte)
// ─────────────────────────────────────────────────────────────────

// PickupStatus — cycle d'une tournée de collecte (mockup §admin/pickup,
// légende l.2575-2579 : Planifiée / À confirmer / Confirmée / En cours /
// Effectuée) + `cancelled` pour l'annulation.
//   scheduled  → to_confirm  (admin finalise les items, demande confirmation producteurs)
//   scheduled  → cancelled
//   to_confirm → confirmed   (producteurs ont confirmé la disponibilité)
//   to_confirm → cancelled
//   confirmed  → collecting  (chauffeur en route — émet outbox pickup.confirmed)
//   confirmed  → cancelled
//   collecting → collected   (tournée terminée, items cochés)
//   collecting → cancelled
enum PickupStatus {
  scheduled // planifiée, créée par l'admin
  to_confirm // en attente de confirmation des producteurs
  confirmed // confirmée, prête à démarrer
  collecting // en cours (chauffeur en tournée)
  collected // effectuée (tous items traités)
  cancelled // annulée (libère les order_items)

  @@map("pickup_status")
}

// ─────────────────────────────────────────────────────────────────
// Enums · Lot 8 (guest checkout)
// ─────────────────────────────────────────────────────────────────

// PaymentMethod — moyen de paiement choisi à la création de la commande.
// Introduit au Lot 8 pour le guest checkout : un invité peut payer en ligne
// (Bictorys, flux webhook existant) OU à la livraison (cash). Les commandes
// `cash_on_delivery` sont confirmables sans payment intent. `online` reste le
// défaut (rétro-compatible avec les commandes client authentifié du Lot 4).
enum PaymentMethod {
  online // paiement Bictorys avant confirmation (défaut)
  cash_on_delivery // paiement cash à la livraison, confirmable sans intent

  @@map("payment_method")
}

// ─────────────────────────────────────────────────────────────────
// users · identité MATA mappée vers Keycloak (Lot 1, relation ajoutée au Lot 2)
// ─────────────────────────────────────────────────────────────────

model User {
  id              String          @id @default(uuid()) @db.Uuid
  keycloakId      String          @unique @map("keycloak_id")
  // Lot 6 : `username` Keycloak (preferred_username) — utilisé pour le lookup
  // producer lors du démarrage d'une session téléconseil (mockup §2888 :
  // l'admin saisit "mor.diop"). Nullable transitoire pour les anciens rows ;
  // le seed backfill, et le webhook /v1/auth/me peut le mettre à jour.
  username        String?         @unique
  email           String?         @unique
  phone           String?         @unique
  displayName     String          @map("display_name")
  role            UserRole
  status          UserStatus      @default(active)
  preferredLocale PreferredLocale @default(fr) @map("preferred_locale")
  lastLoginAt     DateTime?       @map("last_login_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  // Relations
  notificationPreferences NotificationPreference?
  auditLogActor           AuditLog[]              @relation("audit_actor")
  auditLogOnBehalfOf      AuditLog[]              @relation("audit_on_behalf_of")
  producerProfile         ProducerProfile?
  ordersAsClient          Order[]                 @relation("client_orders") // Lot 4
  orderItemsAsProducer    OrderItem[]             @relation("producer_items") // Lot 4 (dénormalisation)
  payoutsAsProducer       Payout[]                @relation("producer_payouts") // Lot 5
  // Lot 6 — téléconseil
  teleconsultCodes         TeleconsultCode[]    @relation("producer_codes")
  teleconsultSessionsAsTC  TeleconsultSession[] @relation("teleconsultant_sessions")
  teleconsultSessionsAsPro TeleconsultSession[] @relation("producer_sessions")
  // Lot 7 — push web
  pushSubscriptions PushSubscription[]
  // Lot 9 — notation producteur (avis post-livraison)
  ratingsReceived ProducerRating[] @relation("producer_ratings")
  ratingsGiven    ProducerRating[] @relation("client_ratings")

  @@index([role, status])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────────
// audit_log · toutes les actions sensibles (Lot 1)
// ─────────────────────────────────────────────────────────────────

model AuditLog {
  id               String   @id @default(uuid()) @db.Uuid
  // `null` = acteur sans row `users` (commande/paiement invité, cf. Lot 8/9).
  // L'identité de contact invité est alors tracée dans `guestPhoneNumber`.
  actorUserId      String?  @map("actor_user_id") @db.Uuid
  onBehalfOfUserId String?  @map("on_behalf_of_user_id") @db.Uuid
  // Téléphone de contact invité quand `actorUserId` est null (traçabilité guest).
  guestPhoneNumber String?  @map("guest_phone_number")
  action           String // ex: "offer.validate", "payout.trigger", "teleconsult.session.start"
  targetType       String   @map("target_type") // ex: "offer", "order", "user"
  targetId         String?  @map("target_id") // peut être null pour actions globales
  oldValue         Json?    @map("old_value")
  newValue         Json?    @map("new_value")
  ipAddress        String?  @map("ip_address")
  userAgent        String?  @map("user_agent")
  requestId        String?  @map("request_id")
  createdAt        DateTime @default(now()) @map("created_at")

  // Relations
  actor      User? @relation("audit_actor", fields: [actorUserId], references: [id])
  onBehalfOf User? @relation("audit_on_behalf_of", fields: [onBehalfOfUserId], references: [id])

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId])
  @@index([onBehalfOfUserId, createdAt])
  @@map("audit_log")
}

// ─────────────────────────────────────────────────────────────────
// notification_preferences · réservé Lot 7 (Lot 1)
// ─────────────────────────────────────────────────────────────────

model NotificationPreference {
  userId       String   @id @map("user_id") @db.Uuid
  // Préférences fines par catégorie d'événement, structure libre validée Zod
  // au niveau service. ex: { order: true, pickup: true, payout: true }
  categories   Json     @default("{}")
  pushEnabled  Boolean  @default(true) @map("push_enabled")
  emailEnabled Boolean  @default(true) @map("email_enabled")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// ─────────────────────────────────────────────────────────────────
// zones · référentiel géographique (Lot 2)
//
// Lecture publique authentifiée pour peupler les selects côté front
// (producteur : choix zone profil / site, client : filtre catalogue).
// CRUD admin UI non livré au Lot 2 (YAGNI). Ajout manuel via seed ou
// SQL jusqu'à ce qu'un vrai workflow d'éditeur soit demandé.
// ─────────────────────────────────────────────────────────────────

model Zone {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique // "pout", "thies-ville", "dahra"
  name        String // "Pout", "Thiès ville", "Dahra"
  region      String // "Thiès", "Dakar", "Louga" — regroupement libre, pas FK
  // Centroid optionnel : rempli au Lot 7 (tournées) si besoin calcul distance.
  centroidLat Float?   @map("centroid_lat")
  centroidLng Float?   @map("centroid_lng")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  producerProfiles ProducerProfile[]
  productionSites  ProductionSite[]
  orders           Order[]
  pickups          Pickup[] // Lot 7 : tournées de collecte planifiées sur la zone

  @@index([active])
  @@map("zones")
}

// ─────────────────────────────────────────────────────────────────
// producer_profiles · profil producteur (Lot 2)
//
// Relation 1:1 avec users (PK = userId). Un user de role=producer a
// au plus un profil. Workflow status : pending → validated/suspended/blacklisted.
// ─────────────────────────────────────────────────────────────────

model ProducerProfile {
  userId        String         @id @map("user_id") @db.Uuid
  type          ProducerType
  status        ProducerStatus @default(pending)
  zoneId        String         @map("zone_id") @db.Uuid
  whatsappPhone String?        @map("whatsapp_phone")
  photoPublicId String?        @map("photo_public_id") // photo profil Cloudinary
  bio           String?        @db.Text // courte description publique

  // Pièces fournies (CNI, photo ferme, ...).
  // Format : Array<{ type: 'cni' | 'farm_photo' | 'other'; publicId: string; uploadedAt: ISO }>
  // Validé Zod côté service (cf. packages/shared/src/schemas/producer.ts au Lot 2 étape 2).
  documents Json @default("[]")

  // bank_details (jsonb) CHIFFRÉ AES-256-GCM applicatif AVANT insertion.
  // Format en clair (avant chiffrement, jamais persisté tel quel) :
  //   { holder: string, iban: string, bic?: string, bankName: string }
  // En DB :
  //   { ciphertext: base64, iv: base64, tag: base64, alg: 'aes-256-gcm', v: 1 }
  // Jamais loggé (pino redact), jamais retourné en clair sans audit reveal
  // (cf. CLAUDE.md §G4 « bank_details chiffré », §G8 « Chiffrement applicatif »).
  bankDetails Json? @map("bank_details")

  validatedAt DateTime? @map("validated_at")
  validatedBy String?   @map("validated_by") @db.Uuid // user.id de l'admin qui a validé
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relations
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  zone   Zone             @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  sites  ProductionSite[]
  offers Offer[]

  @@index([status])
  @@index([zoneId, status])
  @@index([type, status])
  @@map("producer_profiles")
}

// ─────────────────────────────────────────────────────────────────
// production_sites · sites de production / retrait (Lot 2)
//
// Un producteur peut avoir N sites. Les offres sont rattachées à un
// site précis (lieu de retrait pour la collecte MATA).
// ─────────────────────────────────────────────────────────────────

model ProductionSite {
  id             String     @id @default(uuid()) @db.Uuid
  producerUserId String     @map("producer_user_id") @db.Uuid
  name           String // "Poulailler Pout 1"
  type           SiteType
  status         SiteStatus @default(active)
  zoneId         String     @map("zone_id") @db.Uuid
  addressLine    String?    @map("address_line") // rue / lieu-dit (libre)
  geoLat         Float?     @map("geo_lat")
  geoLng         Float?     @map("geo_lng")
  vehicleAccess  String?    @map("vehicle_access") // "moto", "tricycle", "utilitaire", "camion"
  contactName    String?    @map("contact_name")
  contactPhone   String?    @map("contact_phone")
  pickupHours    String?    @map("pickup_hours") // "Matin · 6h-10h" (texte libre MVP)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  // Relations
  producer ProducerProfile @relation(fields: [producerUserId], references: [userId], onDelete: Cascade)
  zone     Zone            @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  offers   Offer[]

  @@index([producerUserId, status])
  @@index([zoneId])
  @@map("production_sites")
}

// ─────────────────────────────────────────────────────────────────
// offers · offres produit + workflow validation (Lot 2)
//
// Workflow status :
//   draft             → pending           (producteur soumet)
//   pending           → draft             (producteur retire, tant que pending)
//   pending           → validated         (admin valide)
//   pending           → changes_requested (admin renvoie pour correction, rejection_reason = feedback)
//   changes_requested → pending           (producteur corrige et re-soumet ; éditable comme draft)
//   pending           → rejected          (admin refuse, définitif, rejection_reason obligatoire)
//   validated → suspended    (admin OU producteur masque)
//   suspended → validated    (admin OU producteur réactive)
//
// PATCH (édition champs) autorisé uniquement en `draft`. Pour modifier
// une offre publiée le producteur doit créer une nouvelle offre.
// ─────────────────────────────────────────────────────────────────

model Offer {
  id               String          @id @default(uuid()) @db.Uuid
  producerUserId   String          @map("producer_user_id") @db.Uuid
  siteId           String          @map("site_id") @db.Uuid
  // DEPRECATED R1 : conservé (nullable) le temps de la bascule, supprimé en R2.
  category         ProductCategory?
  // Source de vérité : FK vers product_categories.slug (lot catégories dynamiques).
  categorySlug     String?         @map("category_slug")
  status           OfferStatus     @default(draft)
  title            String // "Poulet entier" — libre du producteur
  unit             OfferUnit
  quantity         Int // qty totale publiée
  quantityReserved Int             @default(0) @map("quantity_reserved") // Lot 4 (orders)
  priceFcfa        Int             @map("price_fcfa") // prix unitaire demandé par le producteur (FCFA, entier)
  availableFrom    DateTime        @map("available_from") @db.Date
  availableUntil   DateTime?       @map("available_until") @db.Date
  qualityNote      String?         @map("quality_note") // "Poids moyen 1,5 kg"

  // Workflow timestamps & acteurs
  submittedAt     DateTime? @map("submitted_at")
  validatedAt     DateTime? @map("validated_at")
  validatedBy     String?   @map("validated_by") @db.Uuid
  rejectionReason String?   @map("rejection_reason") @db.Text
  suspendedAt     DateTime? @map("suspended_at")
  suspendedBy     String?   @map("suspended_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  producer     ProducerProfile @relation(fields: [producerUserId], references: [userId], onDelete: Cascade)
  site         ProductionSite  @relation(fields: [siteId], references: [id], onDelete: Restrict)
  categoryRef  Category?       @relation(fields: [categorySlug], references: [slug], onDelete: Restrict)
  photos       OfferPhoto[]
  pricingRules PricingRule[] // Lot 3 : overrides éventuels pour cette offre
  orderItems   OrderItem[] // Lot 4 : items de commande référençant cette offre

  @@index([producerUserId, status])
  @@index([category, status, createdAt(sort: Desc)])
  @@index([categorySlug, status, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([siteId])
  @@map("offers")
}

// ─────────────────────────────────────────────────────────────────
// offer_photos · photos d'offre Cloudinary (Lot 2)
//
// On ne stocke QUE le public_id Cloudinary. URL reconstruite côté front
// via SDK (cf. ARCHITECTURE.md §7 « Cloudinary »).
// ─────────────────────────────────────────────────────────────────

model OfferPhoto {
  id                 String   @id @default(uuid()) @db.Uuid
  offerId            String   @map("offer_id") @db.Uuid
  cloudinaryPublicId String   @map("cloudinary_public_id")
  position           Int      @default(0) // ordre d'affichage
  createdAt          DateTime @default(now()) @map("created_at")

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId, position])
  @@map("offer_photos")
}

// ─────────────────────────────────────────────────────────────────
// pricing_rules · règles configurables des 7 composantes (Lot 3)
//
// Scope :
//  - `category` : rule par défaut pour une product_category (category NOT NULL, offer_id NULL)
//  - `offer`    : override pour une offre précise   (category NULL, offer_id NOT NULL)
// Contrainte XOR posée en SQL (CHECK constraint dans la migration).
//
// 4 modèles économiques (cf. mockup §2615 + ARCHITECTURE.md §6) :
//  - commission_pct  : commission = base × commission_pct / 100
//  - fixed_margin    : commission = commission_flat_fcfa (par unité)
//  - mixed           : commission = base × pct / 100 + flat
//  - negotiated      : équivalent fixed_margin côté math, étiquette métier
//
// Pourcentages stockés en entiers (0-100). Bases pct configurables par champ
// (producer_price / final_price / subtotal_pre_pct) pour permettre de tester
// les modèles économiques sans redéploiement.
//
// Lookup actif : findActiveRule(offerId, category, atDate) :
//   1. Cherche override `offer` (offer_id = X, validFrom <= at, validUntil null OR >= at) — prioritaire
//   2. Fallback rule `category` (category = X, mêmes filtres validité)
//   3. Plusieurs rules valides → la plus récente (validFrom desc)
// ─────────────────────────────────────────────────────────────────

model PricingRule {
  id       String           @id @default(uuid()) @db.Uuid
  scope    PricingScope
  // XOR : exactement un des deux non-null. Enforce par CHECK constraint (migration SQL).
  // DEPRECATED R1 : `category` (enum) conservé le temps de la bascule, supprimé en R2.
  category     ProductCategory?
  categorySlug String?          @map("category_slug") // FK product_categories.slug
  offerId      String?          @map("offer_id") @db.Uuid

  model PricingModel

  // Composantes "%" — stockées en entiers 0-100. Default 0 = inactif.
  commissionPct      Int         @default(0) @map("commission_pct")
  commissionBase     PricingBase @default(producer_price) @map("commission_base")
  commissionFlatFcfa Int         @default(0) @map("commission_flat_fcfa")

  safetyMarginPct  Int         @default(0) @map("safety_margin_pct")
  safetyMarginBase PricingBase @default(producer_price) @map("safety_margin_base")

  // Composantes fixes par unité (FCFA entier)
  collectionFcfa Int @default(0) @map("collection_fcfa")
  deliveryFcfa   Int @default(0) @map("delivery_fcfa")
  storageFcfa    Int @default(0) @map("storage_fcfa")
  discountFcfa   Int @default(0) @map("discount_fcfa")

  // Période de validité. validFrom obligatoire (default now), validUntil nullable (ouvert).
  validFrom  DateTime  @default(now()) @map("valid_from")
  validUntil DateTime? @map("valid_until")

  // Acteurs (audit_log écrit en plus côté service pour pricing.rule.update)
  createdBy String  @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  offer       Offer?            @relation(fields: [offerId], references: [id], onDelete: Cascade)
  categoryRef Category?         @relation(fields: [categorySlug], references: [slug], onDelete: Restrict)
  snapshots   PricingSnapshot[]

  @@index([category, validFrom(sort: Desc)])
  @@index([categorySlug, validFrom(sort: Desc)])
  @@index([offerId, validFrom(sort: Desc)])
  @@map("pricing_rules")
}

// ─────────────────────────────────────────────────────────────────
// pricing_snapshots · 7 composantes figées par unité (Lot 3)
//
// IMMUABLE après création (invariant comptable, cf. CLAUDE.md §G4).
// Pas de @updatedAt volontaire. Aucune route UPDATE/DELETE exposée.
// Le service interdit explicitement toute mutation (cf. pricing-snapshot-service.ts).
//
// Toutes les valeurs sont stockées PAR UNITÉ + quantity. Le total ligne
// est obtenu en multipliant à l'affichage. Cela évite les drifts d'arrondi
// si la quantité change en cours de cycle (en réalité Lot 4 impose qty figée
// à la commande, mais le snapshot reste "par unité" pour faciliter les tests
// d'invariant).
//
// Invariant comptable testé :
//   producer_share_fcfa + platform_share_fcfa === final_price_fcfa
//
// Lot 4 ajoutera order_items.pricing_snapshot_id (FK 1:1 inverse).
// ─────────────────────────────────────────────────────────────────

model PricingSnapshot {
  id        String       @id @default(uuid()) @db.Uuid
  modelUsed PricingModel @map("model_used")

  // 7 composantes figées (par unité, en FCFA entier)
  producerPriceFcfa Int @map("producer_price_fcfa")
  commissionFcfa    Int @map("commission_fcfa")
  collectionFcfa    Int @map("collection_fcfa")
  deliveryFcfa      Int @map("delivery_fcfa")
  storageFcfa       Int @map("storage_fcfa")
  safetyMarginFcfa  Int @map("safety_margin_fcfa")
  discountFcfa      Int @map("discount_fcfa")

  // Totaux par unité
  finalPriceFcfa    Int @map("final_price_fcfa")
  producerShareFcfa Int @map("producer_share_fcfa")
  platformShareFcfa Int @map("platform_share_fcfa")

  quantity Int // multiplication pour total ligne

  // Référence à la rule utilisée. Nullable pour ne pas bloquer la suppression
  // future éventuelle de la rule (le snapshot reste comptablement valide tel quel).
  pricingRuleId String? @map("pricing_rule_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  pricingRule PricingRule? @relation(fields: [pricingRuleId], references: [id], onDelete: SetNull)
  orderItem   OrderItem? // Lot 4 : 1:1 inverse (un snapshot peut exister sans order_item le temps Lot 3)

  @@index([pricingRuleId, createdAt(sort: Desc)])
  @@map("pricing_snapshots")
}

// ─────────────────────────────────────────────────────────────────
// orders · en-tête de commande (Lot 4)
//
// Numérotation `CMD-{YYYY}-{NNNN}` via SEQUENCE Postgres `order_number_seq`
// (atomique, pas de collision concurrence). Le service formate année
// courante + padding 4 zéros. La séquence continue sur 2027 sans reset
// automatique — décision MVP, simple, le numéro reste unique globalement.
//
// `client_user_id` nullable : pour Lot 8 guest checkout (orders sans
// compte authentifié, avec `guest_phone` à ajouter dans cette colonne).
// Au Lot 4 il est toujours rempli (client_pro ou client_particulier).
//
// State machine `status` :
//   created    → confirmed  (admin confirme)
//   created    → cancelled  (client OU admin annule, libère stock)
//   confirmed  → collecting (admin lance tournée collecte)
//   confirmed  → cancelled  (admin annule, libère stock)
//   collecting → collected  (tournée terminée chez producteurs)
//   collected  → stored     (entrée dépôt MATA)
//   stored     → delivering (admin lance tournée livraison)
//   delivering → delivered  (client confirme réception)
//
// `payment_status` est un STUB Lot 4 — Lot 5 introduira l'enum dédié
// (pending/paid/refunded/disputed) et la logique webhook Bictorys.
// ─────────────────────────────────────────────────────────────────

model Order {
  id           String      @id @default(uuid()) @db.Uuid
  orderNumber  String      @unique @map("order_number") // ex: CMD-2026-0001
  clientUserId String?     @map("client_user_id") @db.Uuid // null = guest Lot 8
  status       OrderStatus @default(created)

  // Lot 8 — guest checkout. Renseignés UNIQUEMENT quand client_user_id est null
  // (commande invité, sans compte Keycloak). Pour un client authentifié ils
  // restent null : l'identité vient de la relation `client`. `guest_phone_number`
  // au format E.164 sénégalais (+221XXXXXXXXX) validé Zod à la frontière.
  guestFullName    String? @map("guest_full_name")
  guestPhoneNumber String? @map("guest_phone_number")

  // Moyen de paiement choisi à la création. `online` (défaut) = flux Bictorys
  // existant. `cash_on_delivery` = paiement à la livraison (guest), commande
  // confirmable sans payment intent.
  paymentMethod PaymentMethod @default(online) @map("payment_method")

  // Livraison
  deliveryZoneId      String         @map("delivery_zone_id") @db.Uuid
  deliveryAddressLine String         @map("delivery_address_line")
  deliverySlotDate    DateTime       @map("delivery_slot_date") @db.Date
  deliverySlotPeriod  DeliveryPeriod @map("delivery_slot_period")

  // Total figé à la création (somme des order_items.final_price_fcfa × quantity).
  // Permet l'affichage admin/client sans recalculer, et reste cohérent même si
  // une rule pricing change après coup (les snapshots restent immuables).
  totalFcfa Int @map("total_fcfa")

  // Lot 5 : enum dédié PaymentStatus (TEXT stub Lot 4 supprimé migration lot5_payments_part2).
  paymentStatus PaymentStatus @default(pending) @map("payment_status")

  // Timestamps des transitions importantes.
  confirmedAt  DateTime? @map("confirmed_at")
  collectedAt  DateTime? @map("collected_at")
  storedAt     DateTime? @map("stored_at")
  deliveredAt  DateTime? @map("delivered_at")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelReason String?   @map("cancel_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  client  User?       @relation("client_orders", fields: [clientUserId], references: [id], onDelete: SetNull)
  zone    Zone        @relation(fields: [deliveryZoneId], references: [id], onDelete: Restrict)
  items   OrderItem[]
  payment Payment? // Lot 5 : 1:1 inverse (un order a au plus un payment)
  ratings ProducerRating[] // Lot 9 : notes producteurs liées à cette commande

  @@index([status, createdAt(sort: Desc)])
  @@index([clientUserId, createdAt(sort: Desc)])
  @@index([deliverySlotDate, status])
  @@map("orders")
}

// ─────────────────────────────────────────────────────────────────
// order_items · lignes de commande (Lot 4)
//
// Une ligne = une offre × une quantité. 1:1 avec un pricing_snapshot
// figé au moment de la création (cf. CLAUDE.md §G4). `producer_user_id`
// dénormalisé depuis offer.producerUserId pour requêtes producteur
// fréquentes sans join (cf. ARCHITECTURE.md §6).
// ─────────────────────────────────────────────────────────────────

model OrderItem {
  id                String @id @default(uuid()) @db.Uuid
  orderId           String @map("order_id") @db.Uuid
  offerId           String @map("offer_id") @db.Uuid
  producerUserId    String @map("producer_user_id") @db.Uuid // dénormalisé
  quantity          Int
  unitPriceAtOrder  Int    @map("unit_price_at_order") // prix producteur figé
  pricingSnapshotId String @unique @map("pricing_snapshot_id") @db.Uuid // 1:1

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  offer           Offer           @relation(fields: [offerId], references: [id], onDelete: Restrict)
  producer        User            @relation("producer_items", fields: [producerUserId], references: [id], onDelete: Restrict)
  pricingSnapshot PricingSnapshot @relation(fields: [pricingSnapshotId], references: [id], onDelete: Restrict)
  payoutItem      PayoutItem? // Lot 5 : 1:1 inverse (un item est couvert par au plus un payout)
  pickupItem      PickupItem? // Lot 7 : 1:1 inverse (un item est rattaché à au plus une tournée)

  @@index([producerUserId, createdAt(sort: Desc)])
  @@index([orderId])
  @@index([offerId])
  @@map("order_items")
}

// ─────────────────────────────────────────────────────────────────
// producer_ratings · note client d'un producteur après livraison (Lot 9)
//
// 1 note par (commande, producteur) — UNIQUE → idempotent + ancré sur une vraie
// transaction livrée (anti-faux-avis). La moyenne producteur est calculée à la
// lecture (agrégat). Clients authentifiés uniquement (clientUserId non null).
// ─────────────────────────────────────────────────────────────────

model ProducerRating {
  id             String   @id @default(uuid()) @db.Uuid
  producerUserId String   @map("producer_user_id") @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  clientUserId   String   @map("client_user_id") @db.Uuid
  stars          Int // 1..5, validé Zod à la frontière
  comment        String?
  createdAt      DateTime @default(now()) @map("created_at")

  producer User  @relation("producer_ratings", fields: [producerUserId], references: [id], onDelete: Cascade)
  client   User  @relation("client_ratings", fields: [clientUserId], references: [id], onDelete: Cascade)
  order    Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, producerUserId])
  @@index([producerUserId])
  @@map("producer_ratings")
}

// ─────────────────────────────────────────────────────────────────
// idempotency_records · cache de réponses pour POST /v1/orders (Lot 4)
//
// CLAUDE.md §G5 / ARCHITECTURE.md §7 : « Client → MATA : header
// X-Idempotency-Key sur POST /v1/orders, table idempotency_records TTL 24h ».
//
// scope = `${method} ${path}|user:${userId}` pour éviter qu'un user A
// réutilise la key d'un user B. Index `created_at` pour cron cleanup TTL 24h.
// ─────────────────────────────────────────────────────────────────

model IdempotencyRecord {
  key          String // UUID v4 fourni par le client dans X-Idempotency-Key
  scope        String // ex: "POST /v1/orders|user:abc-def"
  statusCode   Int      @map("status_code")
  responseBody Json     @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at")

  @@id([key, scope])
  @@index([createdAt])
  @@map("idempotency_records")
}

// ─────────────────────────────────────────────────────────────────
// payments · payment intent Bictorys (Lot 5)
//
// 1:1 avec orders (FK orderId unique). Le `providerIntentId` est l'ID
// Bictorys retourné à la création du checkout — clé d'idempotence
// triple niveau (cf. ARCHITECTURE.md §7).
//
// `rawWebhookPayload` (jsonb) stocke le DERNIER payload webhook reçu,
// brut, pour audit post-mortem (CLAUDE.md §G5). Aucune dépendance
// applicative sur sa forme — Bictorys peut évoluer sans casser MATA.
//
// `paymentMethod` (wave/orange_money/card) rempli au passage en `paid`,
// utile pour reporting interne et UI (badge mode paiement).
// ─────────────────────────────────────────────────────────────────

model Payment {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @unique @map("order_id") @db.Uuid // 1:1 inverse avec orders

  // ID Bictorys (paymentLink id). Index UNIQUE pour idempotence webhook.
  providerIntentId String @unique @map("provider_intent_id")

  amountFcfa Int           @map("amount_fcfa") // == orders.totalFcfa figé à la création
  currency   String        @default("XOF") // FCFA = XOF (ISO 4217)
  status     PaymentStatus @default(pending)
  paymentUrl String        @map("payment_url") // URL Bictorys (checkout hosted)

  paymentMethod      String? @map("payment_method") // wave / orange_money / card — rempli au paid
  rawWebhookPayload  Json?   @map("raw_webhook_payload") // dernier webhook brut (audit)
  providerCustomer   Json?   @map("provider_customer") // info client payeur (name/phone/email) côté Bictorys

  paidAt     DateTime? @map("paid_at")
  refundedAt DateTime? @map("refunded_at")
  disputedAt DateTime? @map("disputed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, createdAt(sort: Desc)])
  @@map("payments")
}

// ─────────────────────────────────────────────────────────────────
// payouts · reversement producteur via Bictorys disbursement (Lot 5)
//
// Un payout agrège TOUS les order_items éligibles d'un même producer_user_id
// à l'instant t (status='delivered' AND payment_status='paid' AND non encore
// couverts par un payout existant — table de liaison payout_items).
//
// `providerDisbursementId` rempli après call Bictorys. `failureReason`
// rempli en cas d'erreur (coordonnées invalides, plafond, réseau).
//
// CRITIQUE : bank_details du producteur déchiffré UNIQUEMENT en mémoire au
// moment du call Bictorys, jamais persisté en clair, jamais loggé (CLAUDE.md §G4).
// ─────────────────────────────────────────────────────────────────

model Payout {
  id             String       @id @default(uuid()) @db.Uuid
  producerUserId String       @map("producer_user_id") @db.Uuid
  amountFcfa     Int          @map("amount_fcfa") // somme des producer_share_fcfa × quantity des items couverts
  currency       String       @default("XOF")
  status         PayoutStatus @default(pending)

  providerDisbursementId String? @unique @map("provider_disbursement_id") // ID Bictorys retourné

  sentAt        DateTime? @map("sent_at")
  failedAt      DateTime? @map("failed_at")
  failureReason String?   @map("failure_reason") @db.Text
  blockedAt     DateTime? @map("blocked_at")
  blockedReason String?   @map("blocked_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  producer User         @relation("producer_payouts", fields: [producerUserId], references: [id], onDelete: Restrict)
  items    PayoutItem[]

  @@index([producerUserId, status])
  @@index([status, createdAt(sort: Desc)])
  @@map("payouts")
}

// ─────────────────────────────────────────────────────────────────
// payout_items · table de liaison payout ↔ order_item (Lot 5)
//
// UNIQUE sur order_item_id : garantit qu'aucun item n'est versé deux fois
// (idempotence fondamentale du cron process-payouts). Le compute pending
// devient un simple `WHERE order_item_id NOT IN (SELECT order_item_id FROM payout_items)`.
//
// Pas de status propre : suit le payout parent. Pas de soft-delete.
// ─────────────────────────────────────────────────────────────────

model PayoutItem {
  id          String @id @default(uuid()) @db.Uuid
  payoutId    String @map("payout_id") @db.Uuid
  orderItemId String @unique @map("order_item_id") @db.Uuid // UNIQUE : un item ↔ un payout max

  // Montant figé au moment du payout (snapshot anti-drift si pricing change).
  // == order_items.pricing_snapshot.producer_share_fcfa × quantity au moment t.
  amountFcfa Int @map("amount_fcfa")

  createdAt DateTime @default(now()) @map("created_at")

  payout    Payout    @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([payoutId])
  @@map("payout_items")
}

// ─────────────────────────────────────────────────────────────────
// outbox_events · Pattern Outbox pour dispatch async vers n8n (Lot 5, init)
//
// CLAUDE.md §G3 / ARCHITECTURE.md §7 : « API écrit dans outbox_events,
// cron retry vers n8n. Si n8n down, retry rattrape. »
//
// Lot 5 émet `order.confirmed` à la réception du webhook payment.paid.
// Le cron retry-outbox (Lot 7) lira `WHERE dispatched_at IS NULL`
// et appellera n8n. Au Lot 5, les events sont juste insérés en attente.
//
// `eventType` reste un TEXT libre (pas d'enum) pour permettre l'évolution
// rapide des types d'events sans migration à chaque ajout.
// ─────────────────────────────────────────────────────────────────

model OutboxEvent {
  id           String    @id @default(uuid()) @db.Uuid
  eventType    String    @map("event_type") // ex: "order.confirmed", "payout.sent" (Lot 7)
  payload      Json // payload arbitraire, validé Zod côté émetteur
  dispatchedAt DateTime? @map("dispatched_at") // null tant que non dispatché
  retryCount   Int       @default(0) @map("retry_count")
  lastError    String?   @map("last_error") @db.Text
  createdAt    DateTime  @default(now()) @map("created_at")

  // Partial index sur les events en attente (le seul cas d'usage hot pour le cron).
  @@index([createdAt], map: "outbox_events_pending_created_at_idx")
  @@index([eventType, createdAt(sort: Desc)])
  @@map("outbox_events")
}

// ─────────────────────────────────────────────────────────────────
// Enums · Lot 6 (téléconseil)
// ─────────────────────────────────────────────────────────────────

// Raison de fermeture d'une session téléconseil — sert à l'audit + au reporting
// (mockup §2888 affiche "SESSION FERMÉE" sans détail mais le journal admin
// distingue les motifs).
enum TeleconsultCloseReason {
  expired // auto-fermée par le cron quand expires_at < now
  closed_by_teleconsultant // le téléconseiller a cliqué "Fermer"
  revoked_by_producer // le producteur a interrompu via son téléphone (mockup §4268)
  revoked_by_admin // un super_admin a forcé la fin (fraude, dispute)

  @@map("teleconsult_close_reason")
}

// ─────────────────────────────────────────────────────────────────
// teleconsult_codes · code 6 chiffres pour démarrer une session (Lot 6)
//
// Référence : ARCHITECTURE.md §9 « Téléconseil » + CLAUDE.md §G8.
//
// INVARIANTS DE SÉCURITÉ :
//  1. Le code en CLAIR n'est retourné qu'UNE FOIS au moment de la génération
//     (au producteur sur son écran). Stocké uniquement en `code_hash` bcrypt
//     pour vérification (jamais relisible côté serveur).
//  2. Expiration 15 minutes (cf. ARCHITECTURE.md §9 « Expiration 15 minutes,
//     usage unique »).
//  3. Vérification en TEMPS CONSTANT via bcrypt.compare. Message d'erreur
//     identique pour "code invalide" et "code expiré" (CLAUDE.md §G8 :
//     « anti-enumeration »).
//  4. Lockout 5 échecs / 1h → 30 min (failed_attempts + locked_until).
//  5. Code jamais loggé (pino redact `*.code`, `*.codeHash`).
//
// Cycle de vie :
//   created       → used_at NOT NULL (session démarrée, fin de vie du code)
//   created       → expires_at < now (cron cleanup purge si > 1h non utilisé)
// ─────────────────────────────────────────────────────────────────

model TeleconsultCode {
  id              String    @id @default(uuid()) @db.Uuid
  producerUserId  String    @map("producer_user_id") @db.Uuid
  // Hash bcrypt (cost 10). Le code en clair n'est jamais persisté.
  codeHash        String    @map("code_hash")
  expiresAt       DateTime  @map("expires_at") // = createdAt + 15 min
  usedAt          DateTime? @map("used_at") // rempli à startSession

  // Lockout anti-bruteforce : si failed_attempts >= 5 dans la dernière heure,
  // un locked_until est posé et toute tentative de start session pour ce
  // producteur est rejetée jusqu'à expiration.
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  producer User                 @relation("producer_codes", fields: [producerUserId], references: [id], onDelete: Cascade)
  sessions TeleconsultSession[] // 0..1 mais on garde une collection pour clarté

  // Index : lookup des codes actifs (non utilisés, non expirés) par producteur.
  @@index([producerUserId, expiresAt, usedAt])
  // Index : cleanup cron (codes anciens à purger).
  @@index([createdAt])
  @@map("teleconsult_codes")
}

// ─────────────────────────────────────────────────────────────────
// teleconsult_sessions · session déléguée active (Lot 6)
//
// SÉCURITÉ :
//  1. Numéro `SES-{YYYY}-{NNNN}` via SEQUENCE Postgres atomique (cf. order_number_seq).
//  2. Durée 15 minutes max (started_at + 15 min). Auto-fermée par cron.
//  3. teleconsultant_user_id + producer_user_id distincts (FK séparées).
//  4. closed_at + close_reason figés à la fermeture (immutable ensuite).
//  5. Toutes les actions pendant la session sont auditées avec
//     `audit_log.on_behalf_of_user_id = producer_user_id` (déjà préparé Lot 1).
// ─────────────────────────────────────────────────────────────────

model TeleconsultSession {
  id                    String                  @id @default(uuid()) @db.Uuid
  // Numéro SES-{YYYY}-{NNNN} via SEQUENCE — utile pour mockup audit log §4290.
  sessionNumber         String                  @unique @map("session_number")
  teleconsultantUserId  String                  @map("teleconsultant_user_id") @db.Uuid
  producerUserId        String                  @map("producer_user_id") @db.Uuid
  codeId                String                  @map("code_id") @db.Uuid
  startedAt             DateTime                @default(now()) @map("started_at")
  expiresAt             DateTime                @map("expires_at") // = startedAt + 15 min
  closedAt              DateTime?               @map("closed_at")
  closeReason           TeleconsultCloseReason? @map("close_reason")
  closedByUserId        String?                 @map("closed_by_user_id") @db.Uuid // qui a déclenché la fermeture (null si cron)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  teleconsultant User            @relation("teleconsultant_sessions", fields: [teleconsultantUserId], references: [id], onDelete: Restrict)
  producer       User            @relation("producer_sessions", fields: [producerUserId], references: [id], onDelete: Restrict)
  code           TeleconsultCode @relation(fields: [codeId], references: [id], onDelete: Restrict)

  // Index : lookup session active du téléconseiller (closedAt IS NULL).
  @@index([teleconsultantUserId, closedAt])
  // Index : lookup session active du producteur.
  @@index([producerUserId, closedAt])
  // Index : cleanup cron (sessions expirées à fermer).
  @@index([expiresAt, closedAt])
  @@map("teleconsult_sessions")
}

// ─────────────────────────────────────────────────────────────────
// pickups · tournées de collecte chez les producteurs (Lot 7)
//
// Une tournée regroupe N order_items à collecter dans une zone, à une date
// et période données. Numéro `PKP-{YYYY}-{NNNN}` via SEQUENCE atomique
// `pickup_number_seq` (cf. order_number_seq / teleconsult session_number_seq).
//
// `vehicleType` réutilise la même nomenclature que production_sites.vehicle_access
// (moto / tricycle / utilitaire / camion — cf. SITE_VEHICLE_ACCESS) : pas de
// nouvel enum (anti sur-typage, CLAUDE.md §E2). `scheduledPeriod` réutilise
// DeliveryPeriod (morning / afternoon) — pas de nouvel enum non plus.
//
// Toute mutation émet l'event outbox correspondant (pickup.scheduled à la
// création, pickup.confirmed au passage en `collecting`) — CLAUDE.md §G3.
// ─────────────────────────────────────────────────────────────────

model Pickup {
  id                String         @id @default(uuid()) @db.Uuid
  pickupNumber      String         @unique @map("pickup_number") // ex: PKP-2026-0001
  zoneId            String         @map("zone_id") @db.Uuid
  scheduledFor      DateTime       @map("scheduled_for") // date+heure prévue de la tournée
  scheduledPeriod   DeliveryPeriod @map("scheduled_period") // morning / afternoon
  vehicleType       String?        @map("vehicle_type") // moto / tricycle / utilitaire / camion
  driverDisplayName String?        @map("driver_display_name") // nom affiché du chauffeur (texte libre MVP)
  status            PickupStatus   @default(scheduled)

  completedAt  DateTime? @map("completed_at")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelReason String?   @map("cancel_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  zone  Zone         @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  items PickupItem[]

  @@index([zoneId, scheduledFor])
  @@index([status, scheduledFor])
  @@map("pickups")
}

// ─────────────────────────────────────────────────────────────────
// pickup_items · liaison tournée ↔ order_item (Lot 7)
//
// UNIQUE sur order_item_id : un item ne peut être rattaché qu'à une seule
// tournée à la fois (un cancel de tournée libère ses items). `collected`
// coché par le chauffeur item par item pendant la tournée.
//
// FK vers order_items en ON DELETE RESTRICT (PAS cascade) : on ne perd
// jamais l'historique d'une commande même si une tournée est purgée
// (CLAUDE.md / brief Lot 7 : « pas de DELETE CASCADE sur order_items »).
// ─────────────────────────────────────────────────────────────────

model PickupItem {
  id          String  @id @default(uuid()) @db.Uuid
  pickupId    String  @map("pickup_id") @db.Uuid
  orderItemId String  @unique @map("order_item_id") @db.Uuid // UNIQUE : un item ↔ une tournée max
  collected   Boolean @default(false) // coché par le chauffeur pendant la collecte
  notes       String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  pickup    Pickup    @relation(fields: [pickupId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([pickupId])
  @@map("pickup_items")
}

// ─────────────────────────────────────────────────────────────────
// push_subscriptions · abonnements Web Push (VAPID) par utilisateur (Lot 7)
//
// CLAUDE.md §G1 / §G5 : permission demandée APRÈS action signifiante.
// Un utilisateur peut avoir N souscriptions (un par device/navigateur).
// `endpoint` UNIQUE : ré-abonnement du même device = upsert.
//
// Un endpoint qui renvoie 410 Gone lors d'un envoi est supprimé
// IMMÉDIATEMENT (CLAUDE.md §G5 : « endpoints 410 supprimés immédiatement »).
//
// p256dh + auth = clés de chiffrement du payload push (spec Web Push).
// Jamais loggées en clair (pino redact).
// ─────────────────────────────────────────────────────────────────

model PushSubscription {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  endpoint   String    @unique // URL du push service (FCM / Mozilla / Apple)
  p256dh     String // clé publique cliente (base64url)
  auth       String // secret d'authentification (base64url)
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at") // mis à jour à chaque envoi réussi

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}
