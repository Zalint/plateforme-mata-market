# ============================================================
# MATA API · variables d'environnement
# ============================================================
# Toutes les variables sont OPTIONNELLES au Lot 0 (valeurs par défaut
# tolérantes en dev). Elles seront rendues requises au fur et à mesure
# qu'on intègre Bictorys, Cloudinary, resend, Keycloak, etc.
# ============================================================

# Runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Postgres (compose dev par défaut)
DATABASE_URL=postgresql://mata:mata@localhost:5432/mata?schema=public

# Public web URL (CORS)
PUBLIC_WEB_URL=http://localhost:3000

# Keycloak (Lot 1)
KEYCLOAK_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_API_AUDIENCE=

# Bictorys (Lot 5)
BICTORYS_API_KEY=
BICTORYS_WEBHOOK_SECRET=

# Cloudinary (Lot 2)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# resend (Lot 5+)
RESEND_API_KEY=
EMAIL_FROM=

# VAPID Push (Lot 7)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Chiffrement applicatif (Lot 2 — producer bank_details)
ENCRYPTION_KEY=

# hCaptcha (Lot 8 — guest checkout)
HCAPTCHA_SECRET=

# Sentry (optionnel)
SENTRY_DSN=
