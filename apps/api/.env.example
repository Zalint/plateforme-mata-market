# ============================================================
# MATA API · variables d'environnement
# ============================================================
# Toutes les variables sont OPTIONNELLES au Lot 0 (valeurs par défaut
# tolérantes en dev). Elles seront rendues requises au fur et à mesure
# qu'on intègre Bictorys, Cloudinary, resend, Keycloak, etc.
# ============================================================

# Runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Postgres (compose dev par défaut)
DATABASE_URL=postgresql://mata:mata@localhost:5432/mata?schema=public

# Public web URL (CORS)
PUBLIC_WEB_URL=http://localhost:3000

# Keycloak (Lot 1)
KEYCLOAK_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_API_AUDIENCE=
# Service account Keycloak (client confidentiel, scope manage-users) — Lot 9.
# Provisioning des comptes producteurs onboardés par le téléconseiller.
# Secret en variable d'env Render uniquement, jamais commité.
KEYCLOAK_ADMIN_CLIENT_ID=
KEYCLOAK_ADMIN_CLIENT_SECRET=

# Bictorys (Lot 5)
# API_KEY (publique) + API_SECRET (privée) fournies par Bictorys après signup.
# WEBHOOK_SECRET partagé pour signature HMAC SHA-256 des callbacks.
# API_BASE_URL : sandbox ou prod selon Bictorys (à confirmer par doc).
BICTORYS_API_KEY=replace-me
BICTORYS_API_SECRET=replace-me
BICTORYS_WEBHOOK_SECRET=replace-me
BICTORYS_API_BASE_URL=https://api.test.bictorys.com

# Cloudinary (Lot 2)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# resend (Lot 5+)
RESEND_API_KEY=
EMAIL_FROM=

# VAPID Push web (Lot 7)
# Génération de la paire : `pnpm exec web-push generate-vapid-keys`
# VAPID_PUBLIC_KEY est aussi exposée au front via NEXT_PUBLIC_VAPID_PUBLIC_KEY
# (apps/web). VAPID_PRIVATE_KEY ne quitte JAMAIS le serveur (pino redact).
# VAPID_SUBJECT : mailto:contact@mata.sn ou l'URL du site (RFC 8292).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@mata.sn

# n8n (Lot 7) — destination du dispatch outbox (cron retry-outbox).
# Chaque event est POST vers ${N8N_BASE_URL}/<eventType>, signé HMAC SHA-256
# (clé N8N_WEBHOOK_SECRET) dans l'en-tête X-Mata-Signature. Optionnels : si
# absents, le cron log + skip (n8n jamais dans le chemin critique, §G3/§G5).
N8N_BASE_URL=
N8N_WEBHOOK_SECRET=

# Chiffrement applicatif (Lot 2 — producer bank_details)
# Génération : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 32 bytes (256 bits) encodés en base64. Refus de boot si invalide.
ENCRYPTION_KEY=

# hCaptcha (Lot 8 — guest checkout)
HCAPTCHA_SECRET=

# Sentry (optionnel)
SENTRY_DSN=

# Cron jobs (Lot 9) — variables opérationnelles lues directement via process.env
# (hors schéma Zod env.ts car propres aux jobs, pas au boot du serveur).
# CRON_DISABLED=true : met un job en pause (log + exit 0 sans rien traiter).
# CRON_ACTOR_USER_ID : force l'acteur audit du cron process-payouts (UUID d'un
#   admin actif). Vide → fallback sur le premier admin actif en base.
CRON_DISABLED=
CRON_ACTOR_USER_ID=
