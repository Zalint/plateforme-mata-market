# ============================================================
# MATA Web (Next.js) · variables d'environnement
# ============================================================
# Copier vers .env.local pour le dev local. En prod (Render),
# les variables sont injectées par la plateforme.
#
# Variables NEXT_PUBLIC_* : exposées au navigateur.
# Variables sans NEXT_PUBLIC_ : server-only (Route Handlers, middleware).
# ============================================================

NODE_ENV=development

# Keycloak — server-only (utilisés par les /api/auth/* route handlers)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=mata
KEYCLOAK_CLIENT_ID=mata-web
KEYCLOAK_REDIRECT_URI=http://localhost:3000/api/auth/callback

# API MATA — utilisé par les Route Handlers pour proxifier les appels métier
API_BASE_URL=http://localhost:4000

# Keycloak — client (exposés au navigateur)
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=mata
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=mata-web

# URL de l'API MATA exposée au navigateur (CORS configuré côté API)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Cloudinary cloud name (URLs publiques d'image). Identique à
# CLOUDINARY_CLOUD_NAME côté api/.env.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# VAPID public key pour l'abonnement Web Push (Lot 7). Identique à
# VAPID_PUBLIC_KEY côté api/.env. La clé PRIVÉE ne doit JAMAIS être ici.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Sitekey hCaptcha PUBLIQUE (guest checkout, Lot 8). Pendant de HCAPTCHA_SECRET
# côté api/.env (le SECRET ne doit JAMAIS être ici). Vide = widget masqué et
# checkout invité non gardé par captcha (dev). Pour tester en local, utiliser
# la paire de test hCaptcha :
#   NEXT_PUBLIC_HCAPTCHA_SITEKEY=10000000-ffff-ffff-ffff-000000000001
#   (et HCAPTCHA_SECRET=0x0000000000000000000000000000000000000000 côté api)
NEXT_PUBLIC_HCAPTCHA_SITEKEY=

# Affiche le lien « Voir la maquette de référence » sur /welcome. Masqué par
# défaut (artefact de dev). Mettre 'true' pour le réafficher.
NEXT_PUBLIC_SHOW_MOCKUP=false
