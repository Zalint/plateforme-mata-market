    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Vérifie X-Mata-Signature en TEMPS CONSTANT avant tout traitement (CLAUDE.md\n// §G5). Symétrique de signN8nPayload() côté API : HMAC SHA-256 hex sur le RAW\n// BODY exact = JSON.stringify({ eventType, payload }). httpFetch re-sérialise le\n// même objet, donc les bytes signés == bytes reçus → on peut recalculer ici.\n// onError=continueErrorOutput : un throw route vers la sortie d'erreur (index 1)\n// → noeud « Répondre 401 », au lieu de faire échouer l'exécution en 500.\nconst crypto = require('crypto');\nconst secret = $env.MATA_N8N_WEBHOOK_SECRET;\nif (!secret) {\n  throw new Error('MATA_N8N_WEBHOOK_SECRET manquant cote n8n : impossible de verifier la signature');\n}\nconst json = $input.item.json;\nconst headers = json.headers || {};\nconst provided = String(headers['x-mata-signature'] || '');\nconst body = json.body || {};\nconst rawBody = JSON.stringify({ eventType: body.eventType, payload: body.payload });\nconst expected = crypto.createHmac('sha256', secret).update(rawBody, 'utf8').digest('hex');\nconst a = Buffer.from(provided, 'utf8');\nconst b = Buffer.from(expected, 'utf8');\nif (a.length !== b.length || !crypto.timingSafeEqual(a, b)) {\n  throw new Error('Signature HMAC invalide (X-Mata-Signature) pour ' + (body.eventType || 'event inconnu'));\n}\nreturn $input.item;\n",
        "onError": "continueErrorOutput"
      },
