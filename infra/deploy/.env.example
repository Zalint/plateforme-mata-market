# ──────────────────────────────────────────────────────────────────
# Déploiement de TEST en ligne (VPS) · variables
# Copier vers .env (NON commité) et renseigner. Voir docs/DEPLOY-VPS.md.
# ──────────────────────────────────────────────────────────────────

# Domaine de base. 3 sous-domaines DOIVENT pointer (DNS A) vers le VPS :
#   app.<domaine>   api.<domaine>   auth.<domaine>   (+ n8n. / mail. optionnels)
PUBLIC_DOMAIN=mata-test.example.com
# Email pour les certificats Let's Encrypt (Caddy).
ACME_EMAIL=ops@example.com

# Postgres (app + Keycloak)
POSTGRES_PASSWORD=change-me
KC_DB_PASSWORD=change-me

# Keycloak — console admin (https://auth.<domaine>)
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=change-me
# Secret du client service-account `mata-admin-bootstrap`. DOIT correspondre au
# `secret` du client dans infra/keycloak/realm-export.json (défaut : change-me-in-prod).
KC_ADMIN_BOOTSTRAP_SECRET=change-me-in-prod

# Chiffrement AES-256-GCM des bank_details (32 bytes base64) :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Cloudinary (photos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Bictorys (paiement, sandbox)
BICTORYS_API_KEY=
BICTORYS_API_SECRET=
BICTORYS_WEBHOOK_SECRET=
BICTORYS_API_BASE_URL=https://api.test.bictorys.com

# Emails (resend) — laisser vide si non utilisé
RESEND_API_KEY=
EMAIL_FROM=

# hCaptcha (anti-bot guest) — paire publique/secrète. Vide = widget masqué.
HCAPTCHA_SECRET=
NEXT_PUBLIC_HCAPTCHA_SITEKEY=

# Affiche le lien maquette sur /welcome (true/false ; vide = masqué)
NEXT_PUBLIC_SHOW_MOCKUP=

# n8n (automatisations) — secrets >= 32 caractères
N8N_ENCRYPTION_KEY=change-me-encryption-key-32-chars
N8N_WEBHOOK_SECRET=change-me-webhook-secret-32-chars
