# Image « dev stack » pour un déploiement de TEST en ligne (VPS).
#
# Reproduit le mode dev local (`pnpm dev` = turbo → api tsx watch + web next dev),
# avec migrate + seed au démarrage. Volontairement PAS le build prod : on veut
# tester « ce mode dev » en ligne, et les variables NEXT_PUBLIC_* sont lues au
# runtime (pas gravées au build), donc reconfigurables par simple env.
#
# ⚠️ Serveur de DÉVELOPPEMENT (next dev / tsx watch) : pour tester, pas pour de
# la prod à fort trafic. Pour la prod → render.yaml (build optimisé).

FROM node:22-alpine
RUN apk add --no-cache openssl libc6-compat
RUN corepack enable && corepack prepare pnpm@9.12.0 --activate
WORKDIR /repo

# Dépendances (cache : on copie d'abord les manifestes)
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc tsconfig.base.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY packages/shared/package.json packages/shared/
COPY packages/ui/package.json packages/ui/
RUN pnpm install --frozen-lockfile

# Code + build des packages partagés + client Prisma
COPY . .
RUN pnpm --filter @mata/shared build && pnpm --filter @mata/ui build
# `prisma generate` ne se connecte PAS à la base : il lit juste le schéma pour
# générer le client TypeScript. Mais prisma.config.ts valide DATABASE_URL à
# l'import → on fournit une URL factice de build (le vrai DATABASE_URL est
# injecté au runtime par docker-compose).
RUN DATABASE_URL="postgresql://build:build@localhost:5432/build" \
    pnpm --filter @mata/api exec prisma generate

EXPOSE 3000 4000

# Au démarrage : applique les migrations, (re)seed idempotent, puis lance le
# stack dev (api + web). Le seed est idempotent (upserts) → re-run sans danger.
CMD ["sh", "-c", "pnpm --filter @mata/api prisma:migrate:deploy && pnpm --filter @mata/api db:seed && pnpm dev"]
