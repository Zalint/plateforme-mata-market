{
  "name": "mata",
  "private": true,
  "version": "0.0.0",
  "description": "MATA — Du champ à l'assiette · plateforme PMV",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:up": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/restart-dev.ps1",
    "dev:up:reseed": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/restart-dev.ps1 -Reseed",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "biome": "biome",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "turbo": "2.3.3",
    "typescript": "5.7.2"
  },
  "pnpm": {
    "packageExtensions": {
      "fastify": {
        "dependencies": {
          "semver": "^7.6.0"
        }
      }
    }
  }
}
